[Unit]
Description=Cyber Digital Twin Linux Backend API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cybertwin
Group=cybertwin
WorkingDirectory=/opt/cyber-twin
EnvironmentFile=/opt/cyber-twin/.env
ExecStart=/opt/cyber-twin/venv/bin/uvicorn backend.api.main:app --host 0.0.0.0 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips='*'
Restart=always
RestartSec=5s
KillMode=process
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cyber-twin-backend

# Security Sandboxing & Hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cyber-twin/logs /opt/cyber-twin/data
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
